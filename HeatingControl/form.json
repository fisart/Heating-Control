{
  "elements": [
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "Enable controller (only after legacy script is disabled)"
    },
    {
      "type": "CheckBox",
      "name": "DryRun",
      "caption": "Dry run: show commands without switching actuators"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Automatic gas / heat-pump switchover",
      "items": [
        {
          "type": "SelectInstance",
          "name": "ElectricityPriceInstanceID",
          "caption": "LichtBlick electricity-price instance",
          "validModules": [
            "{5C0EEDE9-5C09-4F18-BCD1-CE65CFA7B1B7}"
          ]
        },
        {
          "type": "Label",
          "caption": "Enable or disable automatic switchover using Automatic heating source selection below this instance or on the protected page. Select the LichtBlick instance for verified price, gas tariff, safety margin and price hysteresis. The measured matrix determines the source and power; insufficient measurements or expired prices use gas."
        },
        {
          "type": "NumberSpinner",
          "name": "SourceTransferDelaySeconds",
          "caption": "Pause after stop/mixer command states are acknowledged (seconds)",
          "minimum": 30,
          "maximum": 3600
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpMinimumOffSeconds",
          "caption": "Minimum observed heat-pump off time (seconds)",
          "minimum": 60,
          "maximum": 3600
        },
        {
          "type": "Label",
          "caption": "Defaults: transfer pause 120 s; heat-pump off time 300 s. Verify these against the equipment. Command state is not independent physical feedback."
        }
      ],
      "expanded": true
    },
    {
      "type": "ExpansionPanel",
      "caption": "COP method, operating matrix and electricity break-even price",
      "items": [
        {
          "type": "Select",
          "name": "HeatPumpCOPMethod",
          "caption": "COP method for automatic gas / heat-pump threshold",
          "options": [
            {
              "caption": "Measured COP points with configured temperature tolerance (default)",
              "value": "measured"
            },
            {
              "caption": "Calculated COP surface (3.25–16°C outside; reviewed 39-point fit including dedicated meter)",
              "value": "surface"
            }
          ]
        },
        {
          "type": "Label",
          "caption": "Measured mode keeps the existing exact recorded COP and matching tolerance. Surface mode evaluates the fitted COP at 1% power increments within 3.25–16°C outside. Surface capacity uses required air rise: target plus supply margin minus intake, alongside minimum rise. Absolute intake matching applies only to measured mode. Tested fan command remains required. Airflow and excluded-flap settings do not exclude normal operation; COP retains its recorded calibration basis. Safety margin and price hysteresis apply once in either method. Outside surface support uses gas. The bundled surface includes seven valid dedicated-meter points from 15–16 October; future tests require a reviewed refit."
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpSupplyAboveTargetC",
          "caption": "Model: outgoing air above highest room target (°C)",
          "minimum": 1,
          "maximum": 20,
          "digits": 1
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpMinimumAirRiseC",
          "caption": "Model: minimum outgoing minus incoming air (°C)",
          "minimum": 1,
          "maximum": 20,
          "digits": 1
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpGasEfficiencyPercent",
          "caption": "Useful gas-to-air heating efficiency (%; default 100 is conservative, not measured)",
          "minimum": 50,
          "maximum": 100,
          "digits": 1
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpMatrixTemperatureToleranceC",
          "caption": "Temperature tolerance (°C): measured point matching; surface weather capacity-boundary checks",
          "minimum": 0,
          "maximum": 3,
          "digits": 1
        },
        {
          "type": "List",
          "name": "HeatPumpMatrixOverview",
          "caption": "Measured points (full-step COP; unsettled points excluded)",
          "rowCount": 8,
          "add": false,
          "delete": false,
          "columns": [
            {
              "caption": "Power %",
              "name": "power",
              "width": 70
            },
            {
              "caption": "Outside °C",
              "name": "outside",
              "width": 85
            },
            {
              "caption": "Intake °C",
              "name": "intake",
              "width": 85
            },
            {
              "caption": "Net input kW",
              "name": "input",
              "width": 100
            },
            {
              "caption": "COP (estimate)",
              "name": "cop",
              "width": 100
            },
            {
              "caption": "Eligible",
              "name": "eligible",
              "width": 80
            }
          ],
          "values": []
        },
        {
          "type": "Label",
          "caption": "Matrix axes: outside temperature, intake temperature and power, with fixed fan/airflow context. Useful supply must exceed the active room target by the configured margin. The same rule applies at holiday targets. Gas price, safety margin and price hysteresis are configured in LichtBlick. Airflow and gas efficiency remain estimates."
        },
        {
          "type": "ExpansionPanel",
          "caption": "Advanced: manually supplied calibration",
          "items": [
            {
              "type": "ScriptEditor",
              "name": "HeatPumpMeasuredMatrix",
              "caption": "Optional replacement measured matrix JSON (empty list uses reviewed 14 October calibration)",
              "rowCount": 8
            }
          ]
        }
      ],
      "expanded": true
    },
