          "validVariableTypes": [
            1,
            2
          ]
        },
        {
          "type": "SelectVariable",
          "name": "HeatPumpTestDedicatedExportID",
          "caption": "Dedicated meter: TOTAL exported energy (kWh; direction check, default 57639)",
          "validVariableTypes": [
            1,
            2
          ]
        },
        {
          "type": "SelectVariable",
          "name": "HeatPumpTestDedicatedOnlineID",
          "caption": "Dedicated meter: reachable / online (default 37456)",
          "validVariableTypes": [
            0
          ]
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpTestDedicatedCounterScale",
          "caption": "Dedicated counter kWh per unit (Shelly kWh: 1.0)",
          "minimum": 1e-06,
          "maximum": 1,
          "digits": 6
        },
        {
          "type": "Label",
          "caption": "Dedicated mode uses total active consumed energy across all phases, without house or standby subtraction. A two-minute meter check precedes the steps. COP covers the metered circuit; an external fan is not included unless fed through this meter. Export growth, reset, offline/stale readings or missing boundaries exclude affected measurements. Historical house-meter results retain their original basis."
        },
