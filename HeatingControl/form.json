            }
          ]
        },
        {
          "type": "SelectVariable",
          "name": "HeatPumpTestDedicatedPowerID",
          "caption": "Dedicated meter: TOTAL active power (W; default 28681)",
          "validVariableTypes": [
            1,
            2
          ]
        },
        {
          "type": "SelectVariable",
          "name": "HeatPumpTestDedicatedCounterID",
