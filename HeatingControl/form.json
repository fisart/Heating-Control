{
  "elements": [
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "Enable controller (only after legacy script is disabled)"
    },
    {
      "type": "CheckBox",
      "name": "DryRun",
      "caption": "Dry run: show commands without switching actuators"
    },
    {
      "type": "CheckBox",
      "name": "DebugEnabled",
      "caption": "Write debug log under instance"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Heat-pump capacity test",
      "items": [
        {
          "type": "NumberSpinner",
          "name": "HeatPumpTestStepMinutes",
          "caption": "Time per power step (minutes; default 15)",
          "minimum": 3,
          "maximum": 60,
          "digits": 0
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpTestFanSpeed",
          "caption": "Fixed test fan speed (%)",
          "minimum": 20,
          "maximum": 100,
          "digits": 0
        },
        {
          "type": "SelectVariable",
          "name": "HeatPumpTestExcludedFlapID",
          "caption": "Master-bedroom flap: keep CLOSED during test"
        },
        {
          "type": "SelectVariable",
          "name": "HeatPumpTestPowerMeterID",
          "caption": "Heat-pump circuit power (W)"
        },
        {
          "type": "SelectInstance",
          "name": "HeatPumpTestArchiveID",
          "caption": "Archive Control: enable missing test-variable logging",
          "validModules": [
            "{43192F0B-135B-4CE7-A0A7-1475603F3060}"
          ]
        },
        {
          "type": "SelectVariable",
          "name": "HeatPumpTestFanMeterID",
          "caption": "Fan / heating circuit power (W)"
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpTestAirflowM3h",
          "caption": "Estimated test airflow (m³/h; nameplate default 2000)",
          "minimum": 100,
          "maximum": 10000,
          "digits": 0
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpTestMaximumRoomC",
          "caption": "Stop test at room temperature (°C)",
          "minimum": 15,
          "maximum": 35,
          "digits": 1
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpTestMaximumCoilC",
          "caption": "Stop test at exchanger temperature (°C; software cutoff, verify for equipment)",
          "minimum": 45,
          "maximum": 65,
          "digits": 1
        },
        {
          "type": "Label",
          "caption": "30 → 40 → 50 → 60 → 70 → 80 → 90 → 100%. All other room flaps open; fan speed fixed. Final third of each step, up to five minutes, is averaged. Only stable readings enter the local model. 15 min × 8 = 2 hours plus transfer and baseline. Raw readings and summaries persist under media/heatpump-tests. Start only after reviewing the configured sensors and temperature limits."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Heat-pump comfort and holiday requirements",
      "items": [
        {
          "type": "NumberSpinner",
          "name": "HeatPumpOccupiedMinimumCoilC",
          "caption": "Occupied: minimum heat-pump exchanger temperature (°C)",
          "minimum": 30,
          "maximum": 55,
          "digits": 1
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpHolidayMinimumCoilC",
          "caption": "Holiday: minimum exchanger floor (°C)",
          "minimum": 10,
          "maximum": 40,
          "digits": 1
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpHolidayCoilAboveTargetC",
          "caption": "Holiday: exchanger above highest room target (°C)",
          "minimum": 1,
          "maximum": 25,
          "digits": 1
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpSupplyAboveTargetC",
          "caption": "Model: outgoing air above highest room target (°C)",
          "minimum": 1,
          "maximum": 20,
          "digits": 1
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpMinimumAirRiseC",
          "caption": "Model: minimum outgoing minus incoming air (°C)",
          "minimum": 1,
          "maximum": 20,
          "digits": 1
        },
        {
          "type": "CheckBox",
          "name": "HeatPumpUseTestModel",
          "caption": "Use stable local test points for automatic power selection (within 3°C of measured weather and intake)"
        },
        {
          "type": "Label",
          "caption": "Occupied minimum defaults to 40°C. Holiday minimum = max(floor 20°C, highest room target + 10°C): with targets 10°C, 20°C is permitted. No weather extrapolation. A higher measured power command requires a conservative price recheck; an unverified/missing comparison falls back to gas. Actual fan/flap airflow can differ from the test, so COP remains estimated."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Automatic air-heating source selection",
      "items": [
        {
          "type": "SelectInstance",
          "name": "ElectricityPriceInstanceID",
          "caption": "LichtBlick electricity-price instance",
          "validModules": [
            "{5C0EEDE9-5C09-4F18-BCD1-CE65CFA7B1B7}"
          ]
        },
        {
          "type": "Label",
          "caption": "AutomaticSourceSelection below this instance or on the heating page switches automatic selection on/off. Select the LichtBlick instance above: RecommendationJSON supplies its RecommendedSource and RecommendedHeatPumpPowerPercent together. Missing/unconfirmed/expired recommendations use gas. Automatic selection updates OperatingModeID to the configured heat-pump/gas value. Automatic off keeps that source and uses the retained manual desired power."
        },
        {
          "type": "NumberSpinner",
          "name": "SourceTransferDelaySeconds",
          "caption": "Pause after stop/mixer command states are acknowledged (seconds)",
          "minimum": 30,
          "maximum": 3600
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpMinimumOffSeconds",
          "caption": "Minimum observed heat-pump off time (seconds)",
          "minimum": 60,
          "maximum": 3600
        },
        {
          "type": "Label",
          "caption": "Defaults: transfer pause 120 s; heat-pump off time 300 s. Verify these against the equipment. Command state is not independent physical feedback."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Heating web page",
      "items": [
        {
          "type": "CheckBox",
          "name": "WebEnabled",
          "caption": "Enable passkey-protected heating web page"
        },
        {
          "type": "SelectInstance",
          "name": "VaultInstanceID",
          "caption": "Authentication SecretsManager (none = automatic)",
          "validModules": [
            "{7C5A3841-3F7B-4D2A-9E1C-5B6D8F9A0E12}"
          ]
        },
        {
          "type": "Label",
          "caption": "Open /hook/heating_<instance ID> on your SecretsManager HTTPS origin. The portal discovers this page. Disabled controller or dry run = read-only."
        }
      ]
    },
    {
      "type": "NumberSpinner",
      "name": "IntervalSeconds",
      "caption": "Fallback timer (seconds)",
      "minimum": 5,
      "maximum": 3600
    },
    {
      "type": "NumberSpinner",
      "name": "MaxSensorAgeSeconds",
      "caption": "Max temperature age (0 = disabled)",
      "minimum": 0,
      "maximum": 86400
    },
    {
      "type": "NumberSpinner",
      "name": "ResidualMinOutgoingTemp",
      "caption": "Minimum outgoing air for residual heat (°C)",
      "digits": 1,
      "minimum": 0,
      "maximum": 50
    },
    {
      "type": "SelectVariable",
      "name": "RecoveryEnableID",
      "caption": "Residual heat recovery enable (true = enabled)",
      "validVariableTypes": [
        0
      ]
    },
    {
      "type": "Label",
      "caption": "Optional Boolean switch: false stops residual heat recovery. Normal heating and its fan control remain active. No variable selected = recovery enabled."
    },
    {
      "type": "Label",
      "label": "--- Conditions ---"
    },
    {
      "type": "SelectVariable",
      "name": "MasterDisableID",
      "caption": "Master disable (true = disabled)"
    },
    {
      "type": "SelectVariable",
      "name": "WinterID",
      "caption": "Winter state (true = winter)"
    },
    {
      "type": "SelectVariable",
      "name": "NightDisableID",
      "caption": "Night switch (true = heating off)"
    },
    {
      "type": "SelectVariable",
      "name": "HolidayID",
      "caption": "Holiday state"
    },
    {
      "type": "SelectVariable",
      "name": "AtHomeID",
      "caption": "At home (reference only)"
    },
    {
      "type": "SelectVariable",
      "name": "OperatingModeID",
      "caption": "Operating mode"
    },
    {
      "type": "Label",
      "label": "--- Temperatures ---"
    },
    {
      "type": "SelectVariable",
      "name": "HysteresisID",
      "caption": "Heating and residual recovery hysteresis setting"
    },
    {
      "type": "SelectVariable",
      "name": "ResidualDeltaID",
      "caption": "Residual heat delta setting"
    },
    {
      "type": "SelectVariable",
      "name": "OutsideTempID",
      "caption": "Outside temperature (reference only)"
    },
    {
      "type": "SelectVariable",
      "name": "OutgoingAirTempID",
      "caption": "Outgoing air temperature"
    },
    {
      "type": "SelectVariable",
      "name": "IncomingAirTempID",
      "caption": "Incoming air temperature"
    },
    {
      "type": "SelectVariable",
      "name": "HeatExchangerTempID",
      "caption": "Heat exchanger temperature"
    },
    {
      "type": "SelectVariable",
      "name": "HeatPumpTempID",
      "caption": "Heat pump temperature"
    },
    {
      "type": "Label",
      "label": "--- Fan ---"
    },
    {
      "type": "SelectVariable",
      "name": "FanOnID",
      "caption": "Fan on/off"
    },
    {
      "type": "SelectVariable",
      "name": "FanSpeedID",
      "caption": "Fan speed command"
    },
    {
      "type": "SelectVariable",
      "name": "FanDesiredSpeedID",
      "caption": "Desired fan speed"
    },
    {
      "type": "Label",
      "label": "--- Heat pump ---"
    },
    {
      "type": "SelectVariable",
      "name": "HeatPumpOnID",
      "caption": "Heat pump on/off"
    },
    {
      "type": "SelectVariable",
      "name": "HeatPumpPowerID",
      "caption": "Heat pump power command"
    },
    {
      "type": "SelectVariable",
      "name": "HeatPumpDesiredPowerID",
      "caption": "Desired heat pump power"
    },
    {
      "type": "SelectVariable",
      "name": "HeatPumpHeatModeID",
      "caption": "Heat pump heat/cool mode"
    },
    {
      "type": "Label",
      "label": "--- Gas ---"
    },
    {
      "type": "SelectVariable",
      "name": "GasMixerID",
      "caption": "Gas mixer"
    },
    {
      "type": "SelectVariable",
      "name": "GasPumpID",
      "caption": "Gas exchanger pump"
    },
    {
      "type": "SelectVariable",
      "name": "GasFlowTargetID",
      "caption": "Gas flow temperature command"
    },
    {
      "type": "SelectVariable",
      "name": "GasFlowHeatingID",
      "caption": "Gas heating flow setpoint"
    },
    {
      "type": "SelectVariable",
      "name": "GasFlowIdleID",
      "caption": "Gas idle flow setpoint"
    },
    {
      "type": "Label",
      "label": "--- Operating mode values and mixer ---"
    },
    {
      "type": "NumberSpinner",
      "name": "CoolingModeValue",
      "caption": "Cooling mode value",
      "minimum": 0,
      "maximum": 100
    },
    {
      "type": "NumberSpinner",
      "name": "HeatPumpModeValue",
      "caption": "Heat pump mode value",
      "minimum": 0,
      "maximum": 100
    },
    {
      "type": "NumberSpinner",
      "name": "GasModeValue",
      "caption": "Gas mode value",
      "minimum": 0,
      "maximum": 100
    },
    {
      "type": "NumberSpinner",
      "name": "MixerOpen",
      "caption": "Gas mixer open",
      "minimum": 0,
      "maximum": 100
    },
    {
      "type": "NumberSpinner",
      "name": "MixerClosed",
      "caption": "Gas mixer closed",
      "minimum": 0,
      "maximum": 100
    },
    {
      "type": "PopupButton",
      "name": "RoomConfigurationPopup",
      "caption": "Configure rooms...",
      "popup": {
        "caption": "Room configuration",
        "closeCaption": "Done",
        "items": [
          {
            "type": "Label",
            "caption": "Use the pencil icon to edit a room or Add to create one. Close this window and apply changes to save."
          },
          {
            "type": "List",
            "name": "Rooms",
            "caption": "Rooms",
            "rowCount": 5,
            "add": true,
            "delete": true,
            "loadValuesFromConfiguration": false,
            "columns": [
              {
                "name": "name",
                "caption": "Room name",
                "width": "auto",
                "add": "",
                "edit": {
                  "type": "ValidationTextBox"
                }
              },
              {
                "name": "targetID",
                "caption": "Target temperature variable",
                "width": "200px",
                "add": 0,
                "edit": {
                  "type": "SelectVariable"
                }
              },
              {
                "name": "flapID",
                "caption": "Air flap variable",
                "width": "200px",
                "add": 0,
                "edit": {
                  "type": "SelectVariable"
                }
              },
              {
                "name": "flapType",
                "caption": "Flap command type",
                "width": "100px",
                "visible": false,
                "add": 1,
                "edit": {
                  "type": "Select",
                  "options": [
                    {
                      "caption": "Boolean (0 = off, 1 = on)",
                      "value": 0
                    },
                    {
                      "caption": "Percentage (0 to 100)",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "name": "open",
                "caption": "Open command",
                "width": "80px",
                "visible": false,
                "add": 0,
                "edit": {
                  "type": "NumberSpinner",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              {
                "name": "closed",
                "caption": "Closed command",
                "width": "80px",
                "visible": false,
                "add": 100,
                "edit": {
                  "type": "NumberSpinner",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              {
                "name": "sensors",
                "caption": "Temperature sensors",
                "width": "100px",
                "visible": false,
                "add": [],
                "edit": {
                  "type": "List",
                  "rowCount": 3,
                  "add": true,
                  "delete": true,
                  "columns": [
                    {
                      "name": "id",
                      "caption": "Temperature sensor",
                      "width": "auto",
                      "add": 0,
                      "edit": {
                        "type": "SelectVariable"
                      }
                    }
                  ]
                }
              },
              {
                "name": "statusID",
                "caption": "Room demand status variable (optional)",
                "width": "180px",
                "visible": false,
                "add": 0,
                "edit": {
                  "type": "SelectVariable",
                  "validVariableTypes": [
                    0
                  ]
                }
              },
              {
                "name": "legacyGroupID",
                "caption": "Original room group category (for LastHeatedGroupID)",
                "width": "180px",
                "visible": false,
                "add": 0,
                "edit": {
                  "type": "SelectCategory"
                }
              }
            ],
            "values": [],
            "form": [
              {
                "type": "ValidationTextBox",
                "name": "name",
                "caption": "Room name"
              },
              {
                "type": "List",
                "name": "sensors",
                "caption": "Temperature sensors (average of all selected sensors)",
                "rowCount": 3,
                "add": true,
                "delete": true,
                "columns": [
                  {
                    "name": "id",
                    "caption": "Temperature sensor",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                      "type": "SelectVariable"
                    }
                  }
                ]
              },
              {
                "type": "SelectVariable",
                "name": "targetID",
                "caption": "Target temperature variable"
              },
              {
                "type": "SelectVariable",
                "name": "flapID",
                "caption": "Air flap variable"
              },
              {
                "type": "Select",
                "name": "flapType",
                "caption": "Flap command type",
                "options": [
                  {
                    "caption": "Boolean (0 = off, 1 = on)",
                    "value": 0
                  },
                  {
                    "caption": "Percentage (0 to 100)",
                    "value": 1
                  }
                ]
              },
              {
                "type": "Label",
                "caption": "Boolean flaps: enter 0 or 1. Percentage flaps: enter values from 0 to 100."
              },
              {
                "type": "NumberSpinner",
                "name": "open",
                "caption": "Open command",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "NumberSpinner",
                "name": "closed",
                "caption": "Closed command",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "SelectVariable",
                "name": "statusID",
                "caption": "Room demand status variable (optional)",
                "validVariableTypes": [
                  0
                ]
              },
              {
                "type": "SelectCategory",
                "name": "legacyGroupID",
                "caption": "Original room group category (for LastHeatedGroupID)"
              },
              {
                "type": "Label",
                "caption": "Room status means heating demand, not flap position or residual heat. Leave optional outputs unselected to disable them."
              }
            ]
          }
        ]
      }
    },
    {
      "type": "ExpansionPanel",
      "caption": "Existing status outputs",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "These variables are updated only when Enabled is on and DryRun is off. Select the existing variables to preserve IPSView and chart references."
        },
        {
          "type": "SelectVariable",
          "name": "LegacyResidualHeatingID",
          "caption": "Residual heating status variable (optional)",
          "validVariableTypes": [
            0
          ]
        },
        {
          "type": "SelectVariable",
          "name": "LegacyLastHeatedGroupID",
          "caption": "LastHeatedGroupID variable (optional)",
          "validVariableTypes": [
            1
          ]
        },
        {
          "type": "SelectVariable",
          "name": "LegacyActionLogID",
          "caption": "Heating action log variable (HTML, optional)",
          "validVariableTypes": [
            3
          ]
        },
        {
          "type": "SelectVariable",
          "name": "LegacyConfigSnapshotID",
          "caption": "Configuration snapshot variable (updated on export, optional)",
          "validVariableTypes": [
            3
          ]
        },
        {
          "type": "Label",
          "caption": "LastHeatedGroupID stores the original category ID selected for the last room with demand. Room status outputs are configured in the room editor."
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "RowLayout",
      "items": [
        {
          "type": "Button",
          "caption": "Start heat-pump test",
          "onClick": "HC_StartHeatPumpTest($id, $HeatPumpTestStepMinutes);"
        },
        {
          "type": "Button",
          "caption": "Cancel heat-pump test",
          "onClick": "HC_CancelHeatPumpTest($id);"
        }
      ]
    },
    {
      "type": "RowLayout",
      "items": [
        {
          "type": "Button",
          "caption": "Enable automatic source selection",
          "onClick": "HC_SetAutomaticSourceSelection($id, true);"
        },
        {
          "type": "Button",
          "caption": "Return to manual source selection",
          "onClick": "HC_SetAutomaticSourceSelection($id, false);"
        }
      ]
    },
    {
      "type": "Button",
      "caption": "Register / repair heating webhook",
      "onClick": "HC_SetupHook($id);"
    },
    {
      "type": "Button",
      "caption": "Evaluate now",
      "onClick": "HC_ProcessHeating($id);"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Configuration backup / restore",
      "expanded": false,
      "items": [
        {
          "type": "ScriptEditor",
          "name": "BackupJson",
          "caption": "Backup JSON",
          "value": "",
          "rowCount": 15
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "Button",
              "caption": "Export configuration",
              "onClick": "HC_ExportConfig($id);"
            },
            {
              "type": "Button",
              "caption": "Restore configuration (leaves controller disabled)",
              "onClick": "echo HC_ImportConfig($id, $BackupJson);",
              "confirm": "Replace configuration and leave controller disabled?"
            }
          ]
        }
      ]
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Ready"
    }
  ]
}
