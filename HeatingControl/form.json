{
  "elements": [
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "Enable controller (only after legacy script is disabled)"
    },
    {
      "type": "CheckBox",
      "name": "DryRun",
      "caption": "Dry run: show commands without switching actuators"
    },
    {
      "type": "CheckBox",
      "name": "DebugEnabled",
      "caption": "Write debug log under instance"
    },
    {
      "type": "NumberSpinner",
      "name": "IntervalSeconds",
      "caption": "Fallback timer (seconds)",
      "minimum": 5,
      "maximum": 3600
    },
    {
      "type": "NumberSpinner",
      "name": "MaxSensorAgeSeconds",
      "caption": "Max temperature age (0 = disabled)",
      "minimum": 0,
      "maximum": 86400
    },
    {
      "type": "NumberSpinner",
      "name": "ResidualMinOutgoingTemp",
      "caption": "Minimum outgoing air for residual heat (°C)",
      "digits": 1,
      "minimum": 0,
      "maximum": 50
    },
    {
      "type": "Label",
      "label": "--- Conditions ---"
    },
    {
      "type": "SelectVariable",
      "name": "MasterDisableID",
      "caption": "Master disable (true = disabled)"
    },
    {
      "type": "SelectVariable",
      "name": "WinterID",
      "caption": "Winter state (true = winter)"
    },
    {
      "type": "SelectVariable",
      "name": "NightDisableID",
      "caption": "Night switch (true = heating off)"
    },
    {
      "type": "SelectVariable",
      "name": "HolidayID",
      "caption": "Holiday state"
    },
    {
      "type": "SelectVariable",
      "name": "AtHomeID",
      "caption": "At home (reference only)"
    },
    {
      "type": "SelectVariable",
      "name": "OperatingModeID",
      "caption": "Operating mode"
    },
    {
      "type": "Label",
      "label": "--- Temperatures ---"
    },
    {
      "type": "SelectVariable",
      "name": "HysteresisID",
      "caption": "Hysteresis setting"
    },
    {
      "type": "SelectVariable",
      "name": "ResidualDeltaID",
      "caption": "Residual heat delta setting"
    },
    {
      "type": "SelectVariable",
      "name": "OutsideTempID",
      "caption": "Outside temperature (reference only)"
    },
    {
      "type": "SelectVariable",
      "name": "OutgoingAirTempID",
      "caption": "Outgoing air temperature"
    },
    {
      "type": "SelectVariable",
      "name": "IncomingAirTempID",
      "caption": "Incoming air temperature"
    },
    {
      "type": "SelectVariable",
      "name": "HeatExchangerTempID",
      "caption": "Heat exchanger temperature"
    },
    {
      "type": "SelectVariable",
      "name": "HeatPumpTempID",
      "caption": "Heat pump temperature"
    },
    {
      "type": "Label",
      "label": "--- Fan ---"
    },
    {
      "type": "SelectVariable",
      "name": "FanOnID",
      "caption": "Fan on/off"
    },
    {
      "type": "SelectVariable",
      "name": "FanSpeedID",
      "caption": "Fan speed command"
    },
    {
      "type": "SelectVariable",
      "name": "FanDesiredSpeedID",
      "caption": "Desired fan speed"
    },
    {
      "type": "Label",
      "label": "--- Heat pump ---"
    },
    {
      "type": "SelectVariable",
      "name": "HeatPumpOnID",
      "caption": "Heat pump on/off"
    },
    {
      "type": "SelectVariable",
      "name": "HeatPumpPowerID",
      "caption": "Heat pump power command"
    },
    {
      "type": "SelectVariable",
      "name": "HeatPumpDesiredPowerID",
      "caption": "Desired heat pump power"
    },
    {
      "type": "SelectVariable",
      "name": "HeatPumpHeatModeID",
      "caption": "Heat pump heat/cool mode"
    },
    {
      "type": "Label",
      "label": "--- Gas ---"
    },
    {
      "type": "SelectVariable",
      "name": "GasMixerID",
      "caption": "Gas mixer"
    },
    {
      "type": "SelectVariable",
      "name": "GasPumpID",
      "caption": "Gas exchanger pump"
    },
    {
      "type": "SelectVariable",
      "name": "GasFlowTargetID",
      "caption": "Gas flow temperature command"
    },
    {
      "type": "SelectVariable",
      "name": "GasFlowHeatingID",
      "caption": "Gas heating flow setpoint"
    },
    {
      "type": "SelectVariable",
      "name": "GasFlowIdleID",
      "caption": "Gas idle flow setpoint"
    },
    {
      "type": "Label",
      "label": "--- Operating mode values and mixer ---"
    },
    {
      "type": "NumberSpinner",
      "name": "CoolingModeValue",
      "caption": "Cooling mode value",
      "minimum": 0,
      "maximum": 100
    },
    {
      "type": "NumberSpinner",
      "name": "HeatPumpModeValue",
      "caption": "Heat pump mode value",
      "minimum": 0,
      "maximum": 100
    },
    {
      "type": "NumberSpinner",
      "name": "GasModeValue",
      "caption": "Gas mode value",
      "minimum": 0,
      "maximum": 100
    },
    {
      "type": "NumberSpinner",
      "name": "MixerOpen",
      "caption": "Gas mixer open",
      "minimum": 0,
      "maximum": 100
    },
    {
      "type": "NumberSpinner",
      "name": "MixerClosed",
      "caption": "Gas mixer closed",
      "minimum": 0,
      "maximum": 100
    },
    {
      "type": "PopupButton",
      "name": "RoomConfigurationPopup",
      "caption": "Configure rooms...",
      "popup": {
        "caption": "Room configuration",
        "closeCaption": "Done",
        "items": [
          {
            "type": "Label",
            "caption": "Use the pencil icon to edit a room or Add to create one. Close this window and apply changes to save."
          },
          {
            "type": "List",
            "name": "Rooms",
            "caption": "Rooms",
            "rowCount": 5,
            "add": true,
            "delete": true,
            "loadValuesFromConfiguration": false,
            "columns": [
              {
                "name": "name",
                "caption": "Room name",
                "width": "auto",
                "add": "",
                "edit": {
                  "type": "ValidationTextBox"
                }
              },
              {
                "name": "targetID",
                "caption": "Target temperature variable",
                "width": "200px",
                "add": 0,
                "edit": {
                  "type": "SelectVariable"
                }
              },
              {
                "name": "flapID",
                "caption": "Air flap variable",
                "width": "200px",
                "add": 0,
                "edit": {
                  "type": "SelectVariable"
                }
              },
              {
                "name": "flapType",
                "caption": "Flap command type",
                "width": "100px",
                "visible": false,
                "add": 1,
                "edit": {
                  "type": "Select",
                  "options": [
                    {
                      "caption": "Boolean (0 = off, 1 = on)",
                      "value": 0
                    },
                    {
                      "caption": "Percentage (0 to 100)",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "name": "open",
                "caption": "Open command",
                "width": "80px",
                "visible": false,
                "add": 0,
                "edit": {
                  "type": "NumberSpinner",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              {
                "name": "closed",
                "caption": "Closed command",
                "width": "80px",
                "visible": false,
                "add": 100,
                "edit": {
                  "type": "NumberSpinner",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              {
                "name": "sensors",
                "caption": "Temperature sensors",
                "width": "100px",
                "visible": false,
                "add": [],
                "edit": {
                  "type": "List",
                  "rowCount": 3,
                  "add": true,
                  "delete": true,
                  "columns": [
                    {
                      "name": "id",
                      "caption": "Temperature sensor",
                      "width": "auto",
                      "add": 0,
                      "edit": {
                        "type": "SelectVariable"
                      }
                    }
                  ]
                }
              },
              {
                "name": "statusID",
                "caption": "Room demand status variable (optional)",
                "width": "180px",
                "visible": false,
                "add": 0,
                "edit": {
                  "type": "SelectVariable",
                  "validVariableTypes": [
                    0
                  ]
                }
              },
              {
                "name": "legacyGroupID",
                "caption": "Original room group category (for LastHeatedGroupID)",
                "width": "180px",
                "visible": false,
                "add": 0,
                "edit": {
                  "type": "SelectCategory"
                }
              }
            ],
            "values": [],
            "form": [
              {
                "type": "ValidationTextBox",
                "name": "name",
                "caption": "Room name"
              },
              {
                "type": "List",
                "name": "sensors",
                "caption": "Temperature sensors (average of all selected sensors)",
                "rowCount": 3,
                "add": true,
                "delete": true,
                "columns": [
                  {
                    "name": "id",
                    "caption": "Temperature sensor",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                      "type": "SelectVariable"
                    }
                  }
                ]
              },
              {
                "type": "SelectVariable",
                "name": "targetID",
                "caption": "Target temperature variable"
              },
              {
                "type": "SelectVariable",
                "name": "flapID",
                "caption": "Air flap variable"
              },
              {
                "type": "Select",
                "name": "flapType",
                "caption": "Flap command type",
                "options": [
                  {
                    "caption": "Boolean (0 = off, 1 = on)",
                    "value": 0
                  },
                  {
                    "caption": "Percentage (0 to 100)",
                    "value": 1
                  }
                ]
              },
              {
                "type": "Label",
                "caption": "Boolean flaps: enter 0 or 1. Percentage flaps: enter values from 0 to 100."
              },
              {
                "type": "NumberSpinner",
                "name": "open",
                "caption": "Open command",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "NumberSpinner",
                "name": "closed",
                "caption": "Closed command",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "SelectVariable",
                "name": "statusID",
                "caption": "Room demand status variable (optional)",
                "validVariableTypes": [
                  0
                ]
              },
              {
                "type": "SelectCategory",
                "name": "legacyGroupID",
                "caption": "Original room group category (for LastHeatedGroupID)"
              },
              {
                "type": "Label",
                "caption": "Room status means heating demand, not flap position or residual heat. Leave optional outputs unselected to disable them."
              }
            ]
          }
        ]
      }
    },
    {
      "type": "ExpansionPanel",
      "caption": "Existing status outputs",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "These variables are updated only when Enabled is on and DryRun is off. Select the existing variables to preserve IPSView and chart references."
        },
        {
          "type": "SelectVariable",
          "name": "LegacyResidualHeatingID",
          "caption": "Residual heating status variable (optional)",
          "validVariableTypes": [
            0
          ]
        },
        {
          "type": "SelectVariable",
          "name": "LegacyLastHeatedGroupID",
          "caption": "LastHeatedGroupID variable (optional)",
          "validVariableTypes": [
            1
          ]
        },
        {
          "type": "SelectVariable",
          "name": "LegacyActionLogID",
          "caption": "Heating action log variable (HTML, optional)",
          "validVariableTypes": [
            3
          ]
        },
        {
          "type": "SelectVariable",
          "name": "LegacyConfigSnapshotID",
          "caption": "Configuration snapshot variable (updated on export, optional)",
          "validVariableTypes": [
            3
          ]
        },
        {
          "type": "Label",
          "caption": "LastHeatedGroupID stores the original category ID selected for the last room with demand. Room status outputs are configured in the room editor."
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Evaluate now",
      "onClick": "HC_ProcessHeating($id);"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Configuration backup / restore",
      "expanded": false,
      "items": [
        {
          "type": "ScriptEditor",
          "name": "BackupJson",
          "caption": "Backup JSON",
          "value": "",
          "rowCount": 15
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "Button",
              "caption": "Export configuration",
              "onClick": "HC_ExportConfig($id);"
            },
            {
              "type": "Button",
              "caption": "Restore configuration (leaves controller disabled)",
              "onClick": "echo HC_ImportConfig($id, $BackupJson);",
              "confirm": "Replace configuration and leave controller disabled?"
            }
          ]
        }
      ]
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Ready"
    }
  ]
}
