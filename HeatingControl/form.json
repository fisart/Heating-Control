    {
      "type": "ExpansionPanel",
      "caption": "Heat-pump capacity test",
      "items": [
        {
          "type": "NumberSpinner",
          "name": "HeatPumpTestStepMinutes",
          "caption": "Time per power step (minutes; default 15)",
          "minimum": 3,
          "maximum": 60,
          "digits": 0
        },
        {
          "type": "CheckBox",
          "name": "HeatPumpTestTransientGuardEnabled",
          "caption": "New tests: detect temperature transients and extend clean measurement time (default on)"
        },
        {
          "type": "Label",
          "caption": "Suspected defrost-like drops are detected from air-rise, supply and exchanger temperature together. Hold the same power; exclude 60 seconds before the last healthy reference, wait for 2 minutes of stable recovery, then exclude another 2 minutes. Heat and counter energy use the same retained intervals. Preserve raw data and separate full-step COP. Recovery timeout: 20 minutes; maximum extension: 30 minutes per step. This does not confirm a hardware defrost state or alter normal fan control."
        },
        {
          "type": "CheckBox",
          "name": "HeatPumpTestRebootGuardEnabled",
          "caption": "Pause and automatically resume around the daily Symcon reboot"
        },
        {
          "type": "SelectTime",
          "name": "HeatPumpTestRebootTime",
          "caption": "Daily Symcon reboot time (Symcon local time; default 03:00)"
        },
        {
          "type": "Label",
          "caption": "No step starts unless it can finish at least 5 minutes before reboot, with archive margin. Heating/fan stop and progress is saved. After an actual restart: wait 5 minutes, take a fresh meter check (2 minutes dedicated; 15-minute baseline for legacy house mode), then repeat the pending step. Cancel and safety limits still apply. If no restart is detected within 2 hours, stop the test. This setting does not schedule or trigger a Symcon reboot."
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpTestFanSpeed",
          "caption": "Fixed test fan speed (%)",
          "minimum": 20,
          "maximum": 100,
          "digits": 0
        },
        {
          "type": "SelectVariable",
          "name": "HeatPumpTestExcludedFlapID",
          "caption": "Master-bedroom flap: keep CLOSED during test",
          "validVariableTypes": [
            0,
            1
          ]
        },
        {
          "type": "Select",
          "name": "HeatPumpTestMeterSource",
          "caption": "Electricity basis for NEW tests",
