  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Register / repair page",
      "onClick": "VMC_Setup($id);"
    },
    {
      "type": "Button",
      "caption": "Register Portal link",
      "onClick": "echo VMC_RegisterPortalPage($id);"
    },
    {
      "type": "Button",
      "caption": "Evaluate now",
      "onClick": "VMC_Tick($id);"
    },
    {
      "type": "Button",
      "caption": "Stop and disable automatic",
      "onClick": "VMC_Stop($id);"
    },
    {
      "type": "Button",
      "caption": "Export configuration",
      "onClick": "VMC_ExportToForm($id);"
    },
    {
      "type": "ValidationTextBox",
      "name": "BackupJSON",
      "caption": "Configuration export / import",
      "value": ""
    },
    {
      "type": "Button",
      "caption": "Import configuration (control and web disabled)",
      "onClick": "echo VMC_ImportConfig($id, $BackupJSON);"
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Ready"
    },
    {
      "code": 200,
      "icon": "error",
      "caption": "Configuration requires attention"
    }
  ]
}
