{
  "elements": [
    {
      "type": "Label",
      "caption": "Electricity-price and provisional air-source recommendation. This instance does not command equipment."
    },
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "Enable prices and source recommendation"
    },
    {
      "type": "ValidationTextBox",
      "name": "PostalCode",
      "caption": "Delivery postcode (5 digits)"
    },
    {
      "type": "CheckBox",
      "name": "TariffVerified",
      "caption": "I have checked that these prices, including correction, match my variable gross tariff"
    },
    {
      "type": "NumberSpinner",
      "name": "ThresholdCt",
      "caption": "Reference break-even threshold (ct/kWh); fixed when weather model is off",
      "minimum": 0,
      "maximum": 1000,
      "digits": 3
    },
    {
      "type": "NumberSpinner",
      "name": "SafetyMarginPercent",
      "caption": "Safety margin (%) \u2014 default 25; editable",
      "minimum": 0,
      "maximum": 95,
      "digits": 1
    },
    {
      "type": "NumberSpinner",
      "name": "ReferenceCapacityPercent",
      "caption": "Automatic heat-pump power / learning reference (%)",
      "minimum": 1,
      "maximum": 100,
      "digits": 1
    },
    {
      "type": "Label",
      "caption": "Fixed power when weather model is off. With weather model on, the editable temperature curve supplies power and adjusts the reference threshold."
    },
    {
      "type": "NumberSpinner",
      "name": "HysteresisCt",
      "caption": "Switching hysteresis below safe threshold (ct/kWh)",
      "minimum": 0,
      "maximum": 100,
      "digits": 3
    },
    {
      "type": "ExpansionPanel",
      "caption": "Outside-temperature power and threshold model",
      "items": [
        {
          "type": "CheckBox",
          "name": "WeatherModelEnabled",
          "caption": "Use editable outside-temperature curve for power and threshold"
        },
        {
          "type": "Label",
          "caption": "Provisional starting points: manufacturer COP at different test loads; 35/50% input estimates from site consumption; 65% and 3.19 kW estimated. Not a verified optimum. Cold below first row uses gas; above last row holds its values."
        },
        {
          "type": "NumberSpinner",
          "name": "GasPriceCt",
          "caption": "Gas variable gross price (ct/kWh)",
          "minimum": 0.001,
          "maximum": 100,
          "digits": 3
        },
        {
          "type": "SelectVariable",
          "name": "OutsideTemperatureID",
          "caption": "Outside temperature"
        },
        {
          "type": "List",
          "name": "WeatherCurve",
          "caption": "Editable weather / power / COP points",
          "rowCount": 5,
          "add": true,
          "delete": true,
          "columns": [
            {
              "name": "outsideC",
              "caption": "Outside \u00b0C",
              "width": "150px",
              "add": 0,
              "edit": {
                "type": "NumberSpinner",
                "minimum": -30,
                "maximum": 30,
                "digits": 1
              }
            },
            {
              "name": "powerPercent",
              "caption": "HP command %",
              "width": "150px",
              "add": 50,
              "edit": {
                "type": "NumberSpinner",
                "minimum": 1,
                "maximum": 100,
                "digits": 0
              }
            },
            {
              "name": "cop",
              "caption": "Provisional COP",
              "width": "150px",
              "add": 3,
              "edit": {
                "type": "NumberSpinner",
                "minimum": 0.5,
                "maximum": 10,
                "digits": 2
              }
            },
            {
              "name": "heatPumpKW",
              "caption": "Estimated HP input kW",
              "width": "150px",
              "add": 2.12,
              "edit": {
                "type": "NumberSpinner",
                "minimum": 0.05,
                "maximum": 15,
                "digits": 2
              }
            }
          ]
        },
        {
          "type": "NumberSpinner",
          "name": "WeatherReferenceTemperatureC",
          "caption": "Temperature of reference threshold (\u00b0C)",
          "minimum": -30,
          "maximum": 30,
          "digits": 1
        },
        {
          "type": "NumberSpinner",
          "name": "WeatherReferenceGasPriceCt",
          "caption": "Gas price underlying reference threshold (ct/kWh)",
          "minimum": 0.001,
          "maximum": 100,
          "digits": 3
        },
        {
          "type": "NumberSpinner",
          "name": "WeatherFanKW",
          "caption": "HP fan allowance (kW); no gas fan credit",
          "minimum": 0,
          "maximum": 3,
          "digits": 3
        },
        {
          "type": "NumberSpinner",
          "name": "WeatherPowerStepPercent",
          "caption": "Power command step (%)",
          "minimum": 1,
          "maximum": 10,
          "digits": 0
        },
        {
          "type": "NumberSpinner",
          "name": "WeatherTemperatureHysteresisC",
          "caption": "Outside temperature deadband (\u00b0C)",
          "minimum": 0,
          "maximum": 2,
          "digits": 2
        },
        {
          "type": "NumberSpinner",
          "name": "OutsideTemperatureMaxAgeSeconds",
          "caption": "Maximum outside sensor age (seconds)",
          "minimum": 60,
          "maximum": 7200,
          "digits": 0
        },
        {
          "type": "Label",
          "caption": "Threshold(T) = reference threshold \u00d7 current/reference gas price \u00d7 fan-adjusted COP(T)/fan-adjusted COP(reference). The margin is applied once afterward. Fan-adjusted COP = COP \u00d7 HP kW/(HP kW + fan kW). This is an approximate empirical-reference model, not measured COP."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Price retrieval",
      "items": [
        {
          "type": "NumberSpinner",
          "name": "FetchIntervalMinutes",
          "caption": "Fetch interval (minutes)",
          "minimum": 5,
          "maximum": 1440
        },
        {
          "type": "NumberSpinner",
          "name": "MaxCacheAgeHours",
          "caption": "Maximum cache age (hours)",
          "minimum": 1,
          "maximum": 48
        },
        {
          "type": "NumberSpinner",
          "name": "PriceCorrectionCt",
          "caption": "Verified constant tariff correction (ct/kWh)",
          "minimum": -100,
          "maximum": 100,
          "digits": 3
        },
        {
          "type": "Label",
          "caption": "Uses the public LichtBlick regional price display. Enter your postcode and compare against your contract/app. Percentage-based or time-varying corrections are not supported."
        }
      ]
    },
    {
      "type": "CheckBox",
      "name": "DebugEnabled",
      "caption": "Write debug string below instance"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Daily threshold learner",
      "items": [
        {
          "type": "CheckBox",
          "name": "DailyLearningEnabled",
          "caption": "Calculate threshold from previous day at/after 00:10 Berlin time"
        },
        {
          "type": "Label",
          "caption": "Opt-in learner: stable holiday rooms, no significant radiator/DHW load, pure source. Fixed mode requires reference capacity; weather mode checks the curve and normalizes accepted consumption to the reference temperature/gas price."
        },
        {
          "type": "SelectInstance",
          "name": "ArchiveID",
          "caption": "Archive Control",
          "validModules": [
            "{43192F0B-135B-4CE7-A0A7-1475603F3060}"
          ]
        },
        {
          "type": "NumberSpinner",
          "name": "GasKWhPerM3",
          "caption": "Gas conversion (kWh/m\u00b3)",
          "minimum": 1,
          "maximum": 20,
          "digits": 6
        },
        {
          "type": "NumberSpinner",
          "name": "MinimumReferenceDays",
          "caption": "Required suitable opposite-source days",
          "minimum": 1,
          "maximum": 14
        },
        {
          "type": "NumberSpinner",
          "name": "ElectricalBackgroundKW",
          "caption": "Shared electric background load (kW)",
          "minimum": 0,
          "maximum": 10,
          "digits": 3
        },
        {
          "type": "SelectVariable",
          "name": "GasCounterID",
          "caption": "Cumulative gas counter"
        },
        {
          "type": "SelectVariable",
          "name": "HeatPumpCounterID",
          "caption": "Cumulative heat-pump/shared circuit counter"
        },
        {
          "type": "SelectVariable",
          "name": "AuxCounterID",
          "caption": "Cumulative air/gas auxiliary circuit counter"
        },
        {
          "type": "NumberSpinner",
          "name": "GasCounterScale",
          "caption": "Gas counter multiplier to m\u00b3",
          "minimum": 1e-06,
          "maximum": 100,
          "digits": 6
        },
        {
          "type": "NumberSpinner",
          "name": "HeatPumpCounterScale",
          "caption": "Heat-pump counter multiplier to kWh",
          "minimum": 1e-06,
          "maximum": 100,
          "digits": 6
        },
        {
          "type": "NumberSpinner",
          "name": "AuxCounterScale",
          "caption": "Auxiliary counter multiplier to kWh",
          "minimum": 1e-06,
          "maximum": 100,
          "digits": 6
        },
        {
          "type": "SelectVariable",
          "name": "SourceModeID",
          "caption": "Source mode: 1 heat pump / 2 gas"
        },
        {
          "type": "SelectVariable",
          "name": "HolidayID",
          "caption": "Holiday status: true = holiday"
        },
        {
          "type": "SelectVariable",
          "name": "HeatPumpOnID",
          "caption": "Heat pump on status"
        },
        {
          "type": "SelectVariable",
          "name": "HeatPumpHeatModeID",
          "caption": "Heat pump heating mode: true = heating"
        },
        {
          "type": "SelectVariable",
          "name": "HeatPumpCapacityID",
          "caption": "Actual heat-pump power command (%)"
        },
        {
          "type": "SelectVariable",
          "name": "GasAirPumpID",
          "caption": "Gas air-exchanger pump status"
        },
        {
          "type": "SelectVariable",
          "name": "RadiatorPumpID",
          "caption": "Radiator circuit pump status"
        },
        {
          "type": "SelectVariable",
          "name": "HotWaterPumpID",
          "caption": "DHW storage load pump (not circulation pump)"
        },
        {
          "type": "SelectVariable",
          "name": "StorageTemperatureID",
          "caption": "DHW storage temperature"
        },
        {
          "type": "List",
          "name": "LearningRooms",
          "caption": "Air-heated rooms (all relevant rooms)",
          "rowCount": 4,
          "add": true,
          "delete": true,
          "columns": [
            {
              "name": "name",
              "caption": "Room",
              "width": "auto",
              "add": "",
              "edit": {
                "type": "ValidationTextBox"
              }
            },
            {
              "name": "temperatureID",
              "caption": "Temperature",
              "width": "200px",
              "add": 0,
              "edit": {
                "type": "SelectVariable"
              }
            },
            {
              "name": "targetID",
              "caption": "Target",
              "width": "200px",
              "add": 0,
              "edit": {
                "type": "SelectVariable"
              }
            }
          ]
        },
        {
          "type": "Label",
          "caption": "All selected inputs must be archived. Existing IDs are Berlin defaults; verify them. Counter scales default to gas m\u00b3 and electric pulses at 0.001 kWh/pulse. Shared humidifier load must be comparable between reference days."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Protected LichtBlick web page",
      "items": [
        {
          "type": "CheckBox",
          "name": "WebEnabled",
          "caption": "Enable read-only HTML page and portal link"
        },
        {
          "type": "SelectInstance",
          "name": "VaultInstanceID",
          "caption": "SecretsManager (0 = only eligible instance)",
          "moduleID": "{7C5A3841-3F7B-4D2A-9E1C-5B6D8F9A0E12}"
        },
        {
          "type": "Label",
          "caption": "Uses the existing SecretsManager HTTPS portal and passkey session. Page path: /hook/lichtblick_<instanceID>. Update MyAlarmSystem for automatic Smart Home discovery."
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Persistent prices and historical tariffs",
      "items": [
        {
          "type": "ValidationTextBox",
          "name": "PriceHistoryStartDate",
          "caption": "Electricity contract / history start date (YYYY-MM-DD)"
        },
        {
          "type": "CheckBox",
          "name": "PriceHistoryEnabled",
          "caption": "Collect and retain complete LichtBlick schedules (independent of recommendation enable)"
        },
        {
          "type": "CheckBox",
          "name": "HistoricalFetchEnabled",
          "caption": "Retrieve SMARD historical day-ahead prices; automatically recover the last 7 completed days"
        },
        {
          "type": "Label",
          "caption": "Retrieve SMARD historical day-ahead prices from contract start; recover the last 7 completed days on later runs"
        },
        {
          "type": "List",
          "name": "HistoricalTariffs",
          "caption": "Historical tariff periods (ascending dates; adder includes all net per-kWh components; no monthly basic charge)",
          "rowCount": 5,
          "add": true,
          "delete": true,
          "columns": [
            {
              "name": "from",
              "caption": "Effective from (YYYY-MM-DD)",
              "width": "auto",
              "add": "",
              "edit": {
                "type": "ValidationTextBox"
              }
            },
            {
              "name": "postcode",
              "caption": "Delivery postcode",
              "width": "auto",
              "add": "",
              "edit": {
                "type": "ValidationTextBox"
              }
            },
            {
              "name": "adderNetCt",
              "caption": "Total fixed adder net ct/kWh",
              "width": "auto",
              "add": 0.0,
              "edit": {
                "type": "NumberSpinner",
                "minimum": -100,
                "maximum": 200,
                "digits": 4
              }
            },
            {
              "name": "vatPercent",
              "caption": "VAT %",
              "width": "auto",
              "add": 19.0,
              "edit": {
                "type": "NumberSpinner",
                "minimum": 0,
                "maximum": 100,
                "digits": 4
              }
            },
            {
              "name": "verified",
              "caption": "Contract formula verified",
              "width": "auto",
              "add": false,
              "edit": {
                "type": "CheckBox"
              }
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Fetch prices now",
      "onClick": "LBEP_RefreshPrices($id);"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Retrieve historical prices",
      "items": [
        {
          "type": "ValidationTextBox",
          "name": "HistoryFrom",
          "caption": "First completed day (YYYY-MM-DD)",
          "value": ""
        },
        {
          "type": "ValidationTextBox",
          "name": "HistoryTo",
          "caption": "Last completed day (YYYY-MM-DD, inclusive)",
          "value": ""
        },
        {
          "type": "Button",
          "caption": "Queue historical retrieval (maximum 366 days)",
          "onClick": "echo LBEP_RetrieveHistoricalPrices($id, $HistoryFrom, $HistoryTo);"
        },
        {
          "type": "Button",
          "caption": "Cancel pending historical retrieval (keep stored prices)",
          "onClick": "LBEP_CancelHistoricalImport($id);"
        }
      ]
    },
    {
      "type": "Button",
      "caption": "Recalculate yesterday (once per accepted day)",
      "onClick": "LBEP_CalculateYesterday($id);"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Add historical reference",
      "items": [
        {
          "type": "ValidationTextBox",
          "name": "ReferenceDate",
          "caption": "Completed date (YYYY-MM-DD)",
          "value": ""
        },
        {
          "type": "Button",
          "caption": "Check and add reference day (no threshold change)",
          "onClick": "echo LBEP_AddReferenceDay($id, $ReferenceDate);"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Configuration backup / restore",
      "items": [
        {
          "type": "ScriptEditor",
          "name": "BackupJson",
          "caption": "Configuration JSON",
          "value": "",
          "rowCount": 15
        },
        {
          "type": "Button",
          "caption": "Export configuration",
          "onClick": "LBEP_ExportConfig($id);"
        },
        {
          "type": "Button",
          "caption": "Import (disables recommendation and learning)",
          "onClick": "echo LBEP_ImportConfig($id, $BackupJson);",
          "confirm": "Replace configuration? Recommendation, learning and tariff confirmation will be disabled."
        }
      ]
    },
    {
      "type": "Button",
      "caption": "Clear debug log",
      "onClick": "LBEP_ClearDebug($id);"
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Ready"
    },
    {
      "code": 201,
      "icon": "error",
      "caption": "Invalid configuration"
    }
  ]
}
